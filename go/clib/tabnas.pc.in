# pkg-config for libtabnasmarkdown (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnasmarkdown
Description: markdown parser (libtabnasmarkdown) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnasmarkdown
Cflags: -I${includedir}
